generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HOD
  FACULTY
  STUDENT
  PARENT
  ACCOUNTANT
  EXAM_OFFICER
  LIBRARIAN
  HR_STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  email        String?    @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  student      Student?
  faculty      Faculty?
  parent       Parent?
  auditLogs    AuditLog[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Parent {
  id        String    @id @default(cuid())
  userId    String?   @unique
  user       User?    @relation(fields: [userId], references: [id])
  name      String
  mobile    String?
  email     String?
  students  Student[] @relation("ParentStudents")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Department {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  hodId       String?
  programs    Program[]
  faculty     Faculty[]
  students    Student[]
  subjects    Subject[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Program {
  id           String     @id @default(cuid())
  code         String     @unique
  name         String
  durationYears Int
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  students     Student[]
  subjects     Subject[]
  divisions    Division[]
  feeStructures FeeStructure[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model AcademicYear {
  id        String       @id @default(cuid())
  name      String       @unique
  startDate DateTime
  endDate   DateTime
  active    Boolean      @default(false)
  students  Student[]
  semesters Semester[]
  feeStructures FeeStructure[]
  exams Exam[]
  createdAt DateTime     @default(now())
}

model Semester {
  id             String        @id @default(cuid())
  number         Int
  name           String
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  students       Student[]
  subjects       Subject[]
  divisions      Division[]
  createdAt      DateTime      @default(now())
  @@unique([number, academicYearId])
}

model Division {
  id          String   @id @default(cuid())
  name        String
  capacity    Int?
  programId   String
  semesterId  String
  program     Program  @relation(fields: [programId], references: [id])
  semester    Semester @relation(fields: [semesterId], references: [id])
  students    Student[]
  createdAt   DateTime @default(now())
  @@unique([name, programId, semesterId])
}

model Student {
  id             String        @id @default(cuid())
  studentId      String        @unique
  enrollmentNo   String?       @unique
  admissionNo    String?       @unique
  name           String
  email          String?
  mobile         String?
  dob            DateTime?
  gender         String?
  address        String?
  photoUrl       String?
  status         StudentStatus @default(ACTIVE)
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id])
  parentId       String?
  parent         Parent?       @relation("ParentStudents", fields: [parentId], references: [id])
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id])
  programId      String?
  program        Program?      @relation(fields: [programId], references: [id])
  semesterId     String?
  semester       Semester?     @relation(fields: [semesterId], references: [id])
  divisionId     String?
  division       Division?     @relation(fields: [divisionId], references: [id])
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  attendance     Attendance[]
  leaves         Leave[]
  documents      Document[]
  studentFees    StudentFee[]
  results        Result[]
  bookIssues     BookIssue[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Faculty {
  id            String              @id @default(cuid())
  facultyId     String              @unique
  name          String
  email         String?
  mobile        String?
  designation   String?
  qualification String?
  joiningDate   DateTime?
  status        UserStatus          @default(ACTIVE)
  userId        String?             @unique
  user          User?               @relation(fields: [userId], references: [id])
  departmentId  String?
  department    Department?         @relation(fields: [departmentId], references: [id])
  attendance    FacultyAttendance[]
  leaves        FacultyLeave[]
  subjects      FacultySubject[]
  timetables    Timetable[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model Subject {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  credits      Float?
  type         String?
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  programId    String?
  program      Program?     @relation(fields: [programId], references: [id])
  semesterId   String?
  semester     Semester?    @relation(fields: [semesterId], references: [id])
  attendance   Attendance[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  subjectId String
  date      DateTime
  period    Int              @default(0)
  status    AttendanceStatus
  student   Student          @relation(fields: [studentId], references: [id])
  subject   Subject          @relation(fields: [subjectId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  @@unique([studentId, subjectId, date, period])
}

model FacultyAttendance {
  id        String           @id @default(cuid())
  facultyId String
  date      DateTime
  status    AttendanceStatus
  faculty   Faculty          @relation(fields: [facultyId], references: [id])
  createdAt DateTime         @default(now())
  @@unique([facultyId, date])
}

model Leave {
  id        String      @id @default(cuid())
  studentId String
  fromDate  DateTime
  toDate    DateTime
  reason    String
  status    LeaveStatus @default(PENDING)
  student   Student     @relation(fields: [studentId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model FacultyLeave {
  id        String      @id @default(cuid())
  facultyId String
  fromDate  DateTime
  toDate    DateTime
  reason    String
  status    LeaveStatus @default(PENDING)
  faculty   Faculty     @relation(fields: [facultyId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Document {
  id        String  @id @default(cuid())
  studentId String
  name      String
  type      String
  url       String
  verified  Boolean @default(false)
  student   Student @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  module    String
  recordId  String?
  metadata  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}


model Institute {
  id        String   @id @default(cuid())
  name      String
  address   String
  phone1    String?
  phone2    String?
  email     String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  capacity  Int?
  type      String?
  timetables Timetable[] @relation("TimetableRoom")
  examSchedules ExamSchedule[] @relation("ExamRoom")
  createdAt DateTime @default(now())
}

model FacultySubject {
  id        String  @id @default(cuid())
  facultyId String
  subjectId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([facultyId, subjectId])
}

model Timetable {
  id         String   @id @default(cuid())
  dayOfWeek  Int
  startTime  String
  endTime    String
  divisionId String
  subjectId  String
  facultyId  String
  roomId     String?
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id])
  faculty    Faculty  @relation(fields: [facultyId], references: [id])
  room       Room?    @relation("TimetableRoom", fields: [roomId], references: [id])
  createdAt  DateTime @default(now())
  @@index([divisionId, dayOfWeek])
  @@index([facultyId, dayOfWeek])
}

model FeeStructure {
  id        String   @id @default(cuid())
  name      String
  academicYearId String?
  programId String?
  amount    Decimal  @db.Decimal(12,2)
  dueDate   DateTime?
  active    Boolean  @default(true)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  program Program? @relation(fields: [programId], references: [id])
  studentFees StudentFee[]
  createdAt DateTime @default(now())
}

model StudentFee {
  id        String   @id @default(cuid())
  studentId String
  feeStructureId String
  amountDue Decimal @db.Decimal(12,2)
  amountPaid Decimal @default(0) @db.Decimal(12,2)
  status    String   @default("PENDING")
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  payments Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id            String @id @default(cuid())
  studentFeeId  String
  receiptNo     String @unique
  amount        Decimal @db.Decimal(12,2)
  method        String
  transactionNo String?
  paidAt        DateTime @default(now())
  studentFee    StudentFee @relation(fields: [studentFeeId], references: [id])
}

model Exam {
  id            String @id @default(cuid())
  name          String
  examType      String
  academicYearId String?
  startDate     DateTime?
  endDate       DateTime?
  status        String @default("DRAFT")
  academicYear  AcademicYear? @relation(fields: [academicYearId], references: [id])
  schedules     ExamSchedule[]
  results       Result[]
  createdAt     DateTime @default(now())
}

model ExamSchedule {
  id        String @id @default(cuid())
  examId    String
  subjectId String
  date      DateTime
  startTime String
  endTime   String
  roomId    String?
  exam      Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id])
  room      Room? @relation("ExamRoom", fields: [roomId], references: [id])
  @@unique([examId, subjectId])
}

model Result {
  id        String @id @default(cuid())
  examId    String
  studentId String
  subjectId String
  marks     Float?
  grade     String?
  status    String @default("DRAFT")
  exam      Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id])
  @@unique([examId, studentId, subjectId])
}

model Book {
  id        String @id @default(cuid())
  isbn      String? @unique
  title     String
  author    String?
  category  String?
  quantity  Int @default(1)
  available Int @default(1)
  issues    BookIssue[]
  createdAt DateTime @default(now())
}

model BookIssue {
  id        String @id @default(cuid())
  bookId    String
  studentId String?
  issueDate DateTime @default(now())
  dueDate   DateTime
  returnDate DateTime?
  fine      Decimal @default(0) @db.Decimal(10,2)
  book      Book @relation(fields: [bookId], references: [id])
  student   Student? @relation(fields: [studentId], references: [id])
}

model Notice {
  id        String @id @default(cuid())
  title     String
  content   String
  audience  String
  published Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
}
